# LLM provider: auto | groq | ollama | offline
CSI_LLM_PROVIDER=auto
# Free key from https://console.groq.com (fast hosted inference)
GROQ_API_KEY=
CSI_GROQ_MODEL=llama-3.1-8b-instant
# Local, private inference with Ollama (ollama pull gemma2:9b)
OLLAMA_URL=http://localhost:11434
CSI_OLLAMA_MODEL=gemma2:9b
# Agent guardrails
CSI_ROUTE_THRESHOLD=0.60
CSI_ESCALATION_URGENCY=80
# API protection: set a key to require the X-API-Key header; requests per minute per client (0 = off)
CSI_API_KEY=
CSI_RATE_LIMIT=60
# Help-article search: dense | hybrid | bm25, and optional cross-encoder re-ranking (1 = on, slower)
CSI_KB_SEARCH_MODE=dense
CSI_RERANK=0
# Classifier to serve: auto (best tested model) | distilbert | tfidf
CSI_CLASSIFIER=auto
